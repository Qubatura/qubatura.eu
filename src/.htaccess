# ── qubatura.eu — polityka cache ──────────────────────────────────────────────
# PROBLEM który to rozwiązuje: serwer nie wysyłał żadnego Cache-Control → iOS Safari
# cache'ował index.html heurystycznie i ładował STARE moduły mimo świeżego ?v= tokenu
# (cache-bust przez ?v= działa TYLKO gdy sam HTML jest świeży). Efekt: deploy „nie wskakiwał".
#
# Zasada:
#   HTML  → zawsze rewalidowany (no-cache) → nowe ?v= tokeny łapią się natychmiast.
#   Assety (js/css/media) → wersjonowane przez ?v= w URL, więc mogą leżeć długo (immutable).

<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|mjs|css|woff2?|ttf|otf|eot|png|jpe?g|gif|webp|avif|svg|ico|mp3|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Fallback gdyby mod_headers był niedostępny (LiteSpeed/Apache czytają mod_expires też).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType audio/mpeg "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
